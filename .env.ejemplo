# ============================================================
# EnergiAI - Variables de entorno
# Copiar a ".env" (NO se commitea) y ajustar por entorno.
# docker compose lee este archivo para interpolar ${VAR}.
# ============================================================

# --- MySQL ---
# Usuario de la aplicacion para la base "energiai"
DB_USERNAME=energiai_app
# Password root de MySQL (secreto)
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# --- DB Password (Docker Secret) ---
# La contrasena de la BD para la app NO va en .env: se monta como Docker Secret.
# Crear el archivo "secrets/db_password.txt" (dev) / "secrets/db_password_prod.txt" (prod)
# con la contrasena de "DB_USERNAME". El backend la lee en /run/secrets/db_password
# y MySQL en MYSQL_PASSWORD_FILE (ver compose.yml y compose.prod.yml).

# --- API Key (frontend, se inyecta en build time) ---
# Dev: usada por compose.yml (ARG API_KEY_SECRET)
API_KEY_SECRET=CHANGE_ME_API_KEY
# Prod: usada por compose.prod.yml (ARG API_KEY_SECRET_PROD) y por Caddy
# para inyectar la key de forma server-side (Docker Secret).
# DEBE coincidir con el contenido de secrets/api_key_secret_prod.txt
API_KEY_SECRET_PROD=CHANGE_ME_API_KEY_PROD

# --- CORS: origenes permitidos para el frontend (coma-separado) ---
# Con Caddy todo el trafico es mismo origen, por lo que el CORS normalmente
# no aplica; se mantiene por si se accede directo a la API (curl, pruebas).
# Dev: localhost + dominios de pruebas
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:8080

# --- Caddy (gateway TLS de producción) ---
# Dominio del subdominio asignado por tu equipo (ej. energiai-06.navmx.com).
# Caddy obtiene y renueva el certificado HTTPS automaticamente (Let's Encrypt).
# Requiere el registro A de ese subdominio apuntando a la IP publica de la VM.
CADDY_DOMAIN=energiai-06.navmx.com

# --- SMTP / CORREO (envío de códigos de verificación) ---
# En producción se recomienda una password de aplicación de Gmail (16 caracteres).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=energiai.noreply@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=energiai.noreply@gmail.com

# --- Verificación de correo ---
VERIFICACION_TTL_MINUTOS=10
VERIFICACION_MAX_INTENTOS=3
VERIFICACION_RATE_LIMIT_POR_HORA=5